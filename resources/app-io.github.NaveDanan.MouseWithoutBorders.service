[Unit]
Description=Mouse Without Borders for Linux
Documentation=file:///usr/share/doc/powertoys-mouse-without-borders/README.md
PartOf=graphical-session.target
After=graphical-session.target xdg-desktop-portal.service

[Service]
Type=simple
ExecStart=/usr/bin/powertoys-mouse-without-borders daemon
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=graphical-session.target
